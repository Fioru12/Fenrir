# Configuration
# Copy this file to .env and fill in your values

# Required
SECRET_KEY=change-this-to-a-random-secret-key

# Optional
LOG_LEVEL=INFO
DEBUG=false

# Optional: API key for the AlienVault OTX (Open Threat Exchange) feed.
# Get a free key by registering at https://otx.alienvault.com (Settings > API Integration).
# If left unset, Fenrir skips the OTX feed with a warning and only collects CISA KEV.
OTX_API_KEY=

# Optional: self-hosted MISP instance (https://www.misp-project.org).
# Both required or the MISP feed is skipped like OTX above.
MISP_URL=
MISP_API_KEY=
